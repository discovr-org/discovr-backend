API_PORT=8080
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://discovr-admin.vercel.app,https://discovr-frontend-phi.vercel.app
CATALOG_DATA_SOURCE=supabase
# Prefer discovr-backend/.env for these (loaded automatically):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Cloudflare Images (admin cover + host avatar uploads). Prefer an Images API token:
# CLOUDFLARE_TOKEN=   # Create Token → Account → Cloudflare Images → Edit
# CLOUDFLARE_ACCOUNT_ID=   # optional; auto-detected from the token if omitted
# Do not use a Global API Key (cfk_) here — that needs CLOUDFLARE_EMAIL too.
#
# Twilio SMS (phone OTP login) — From must be a Twilio number:
# TWILIO_ACCOUNT_SID=AC…
# TWILIO_AUTH_TOKEN=…
# TWILIO_FROM_NUMBER=DSCOVR   # India alphanumeric sender (not support phone)
